{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "local-backend": {
      "root": "client/packages/local-backend",
      "framework": "node",
      "entrypoint": "src/index.mjs"
    },
    "stemstudio-copilot": {
      "root": "stemstudio-copilot",
      "framework": "python",
      "entrypoint": "src/index.py"
    },
    "stemstudio-multiplayer": {
      "root": "stemstudio-multiplayer",
      "runtime": "container"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
